# NEXO - Faturamento Inteligente | .gitignore

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.audit_tmp/
.coverage
htmlcov/

# === Ambientes virtuais ===
venv/
.venv/
env/
ENV/

# === IDE / Editor ===
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# === Memória local da IA (Claude Code) ===
# Mantém o contexto/regras privadas da IA fora do repositório público.
.claude/

# === Flask / app ===
instance/
*.db
*.sqlite
*.sqlite3
# Auxiliares do SQLite: app.py ativa WAL; -wal/-journal guardam páginas com dados.
*.db-wal
*.db-shm
*.db-journal
*.sqlite*-wal
*.sqlite*-shm
*.sqlite*-journal

# === Uploads e Dados (Arquivos de Clientes / LGPD) ===
uploads/*
!uploads/.gitkeep
dados/**/*.xlsx
dados/**/*.csv
dados/**/*.xls
dados/**/*.pdf

# Mídias da Base de Conhecimento (CMS)
static/uploads/guia/*
!static/uploads/guia/.gitkeep

# === Variáveis de ambiente ===
.env
.env.local
.env.*.local
.env.*
!.env.example

# === Logs ===
*.log
logs/

# Backups privados e artefatos locais (preserva SQL de schema/migrações)
backups/
backup/
*.bak
*.tmp
*.dump
*.dump.*
*.backup
*.backup.*
*.sql.gz
*.sql.gpg
*.age
*.pgpass
pgpass.conf
pg_service.conf
.pg_service.conf
*.zip
# Demais formatos do pg_dump fora de backups/: plain, tar, diretório (toc.dat)
# e custom com outra extensão. Sem *.sql global: schema_nexo_mvp_v4.sql é versionado.
dumps/
dump/
dump.sql
*.sql.*
*.custom
*.tar
*.tar.*
*.tgz
*.dat
*.dat.*
# Chaves e credenciais locais
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials.json
secrets/
private/

# === Sistema operacional ===
Thumbs.db
ehthumbs.db
