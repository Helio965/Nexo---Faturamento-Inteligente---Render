# Exemplo sem credenciais. Copie para .env somente para desenvolvimento local.
# No Render, preencha as variáveis no painel; não envie .env ao GitHub.
FLASK_ENV=development
# Gere uma chave aleatória própria. Obrigatória e não vazia em produção.
SECRET_KEY=
# Desenvolvimento: vazio usa SQLite local. Produção: PostgreSQL obrigatório.
DATABASE_URL=
# Migrações: conexão direta ou Session pooler, com SSL; não Transaction pooler.
DIRECT_URL=
NEXO_DB_DIRECT=0
PROXY_FIX_HOPS=0
# Origem pública canônica (https://dominio) dos links enviados por e-mail
# (ativação, recuperação de senha, chamados, publicação). Obrigatória e https
# em produção; no Render, RENDER_EXTERNAL_URL vale como padrão.
NEXO_PUBLIC_URL=
# Hosts adicionais aceitos nas requisições (CSV; ".dominio" aceita subdomínios).
# Em produção, o host da origem pública e o da plataforma são aceitos sempre.
NEXO_TRUSTED_HOSTS=
# 1 = Content-Security-Policy em modo somente-relatório (observar sem bloquear).
NEXO_CSP_REPORT_ONLY=0
# 1 = ao definir/redefinir senha, consulta vazamentos conhecidos por k-anonimato
# (só 5 caracteres do hash saem do servidor; a senha nunca). Indisponibilidade do
# serviço NÃO bloqueia a troca (fail-open, registrado em log). Padrão: desligado.
NEXO_SENHAS_VAZADAS=0
# Pool de conexões do SQLAlchemy — só vale com PostgreSQL (ignorado em SQLite).
NEXO_DB_POOL_SIZE=5
NEXO_DB_MAX_OVERFLOW=10
NEXO_DB_POOL_TIMEOUT=10
# 1 = ecoa o SQL no log em desenvolvimento (nunca em produção).
NEXO_SQL_ECHO=0
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=20
SOCKETIO_CORS_ORIGINS=http://127.0.0.1:5000,http://localhost:5000
RATELIMIT_STORAGE_URI=memory://
# Preencher somente para criação inicial, manual, do administrador.
ADMIN_EMAIL=
ADMIN_NOME=
ADMIN_SENHA=
# Brevo via HTTPS, remetente verificado (recomendado para Render Free).
BREVO_API_KEY=
MAIL_DEFAULT_SENDER=
# Alternativa SMTP em ambiente que permita as portas SMTP.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
# Opcionais. Sem credenciais, preserva os fallbacks locais de IA/NexoBot.
ANTHROPIC_API_KEY=
# NexoBot funciona sem token. Com token fine-grained ("Make calls to Inference
# Providers"), um modelo apenas redige respostas do Guia (uso cobrado pela HF).
HF_API_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
